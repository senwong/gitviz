#!/usr/bin/env bash
#
# Runs the parts of the test suite that do not depend on gpui.
#
# The UI (`view.rs`/`theme.rs`) pulls in gpui and its dependency tree, which is
# expensive to compile. This script builds a throwaway crate that includes only
# the pure modules (config, discovery, emoji, git, layout, markdown, review) and
# runs their unit tests plus the real-git integration tests. It is a fast way to
# verify the git/config/layout logic before (or without) the full UI build.
#
# Usage:
#   ./script/pure-test            # run everything
#   ./script/pure-test --lib      # only the pure unit tests
#   ./script/pure-test --test git_integration

set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
tmp="$(mktemp -d "${TMPDIR:-/tmp}/gitviz-pure.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT

mkdir -p "$tmp/src" "$tmp/tests"

cat > "$tmp/Cargo.toml" <<EOF
[package]
name = "gitviz_pure"
version = "0.0.0"
edition = "2024"

[workspace]

[dependencies]
anyhow = "1"

[lib]
path = "src/lib.rs"
EOF

cp "$here/rust-toolchain.toml" "$tmp/rust-toolchain.toml"

cat > "$tmp/src/lib.rs" <<EOF
#[path = "$here/src/config.rs"]
pub mod config;
#[path = "$here/src/discovery.rs"]
pub mod discovery;
#[path = "$here/src/emoji.rs"]
pub mod emoji;
#[path = "$here/src/git.rs"]
pub mod git;
#[path = "$here/src/layout.rs"]
pub mod layout;
#[path = "$here/src/markdown.rs"]
pub mod markdown;
#[path = "$here/src/review.rs"]
pub mod review;
EOF

sed 's/use gitviz::git/use gitviz_pure::git/' \
    "$here/tests/git_integration.rs" > "$tmp/tests/git_integration.rs"

cd "$tmp"
export PATH="$HOME/.cargo/bin:$PATH"
export CARGO_INCREMENTAL=0
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$tmp/target}"

exec cargo test "$@"
